# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Django ---------------------------------------------------------------
# 1 — режим разработки (локально), 0 — продакшен
DJANGO_DEBUG=1
# Обязателен при DJANGO_DEBUG=0. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Для продакшена: https://saqshy.kz,https://www.saqshy.kz
DJANGO_CSRF_TRUSTED_ORIGINS=
# Публичный адрес сайта без слэша в конце (canonical, sitemap, вебхук бота)
SITE_URL=http://127.0.0.1:8000

# --- База данных ----------------------------------------------------------
# Пусто — SQLite (db.sqlite3). Продакшен — PostgreSQL:
# DATABASE_URL=postgres://saqshy:пароль@db:5432/saqshy
DATABASE_URL=

# --- Бренд и контакты (показываются на сайте) -----------------------------
BRAND_NAME=Saqshy
CONTACT_PHONE=+7 700 000 00 00
# Номер WhatsApp только цифрами, без +
CONTACT_WHATSAPP=77000000000
# Username Telegram без @
CONTACT_TELEGRAM=saqshy_kz
CONTACT_EMAIL=info@example.kz
CONTACT_CITY=Алматы
CONTACT_ADDRESS=Алматы
CONTACT_HOURS=Пн–Сб 9:00–20:00
CONTACT_INSTAGRAM=
# Реквизиты в подвале: «ИП Иванов, ИИН 000000000000»
LEGAL_INFO=

# --- Telegram-бот для сотрудников -----------------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# ID рабочей группы, куда приходят заявки (бот подскажет его по команде /start в группе)
TELEGRAM_CHAT_ID=
# Любая длинная случайная строка — защищает вебхук
TELEGRAM_WEBHOOK_SECRET=

# --- Аналитика и реклама --------------------------------------------------
GA4_ID=
YANDEX_METRIKA_ID=
# Google Ads: AW-XXXXXXXXX и метка конверсии «Заявка»
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=

# --- Почта (дублирование заявок на e-mail) --------------------------------
# По умолчанию письма печатаются в консоль. Для SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@example.kz
# Через запятую
LEAD_NOTIFY_EMAILS=

# --- Будущие модули (пока выключены) --------------------------------------
FEATURE_QUIZ=0
FEATURE_CATALOG=0
FEATURE_CART=0
FEATURE_ACCOUNTS=0

# --- Для docker-compose (продакшен) ---------------------------------------
DOMAIN=saqshy.kz
POSTGRES_DB=saqshy
POSTGRES_USER=saqshy
POSTGRES_PASSWORD=
